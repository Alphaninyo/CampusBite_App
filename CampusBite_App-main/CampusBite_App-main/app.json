{
  "expo": {
    "name": "CampusBite",
    "slug": "campusbite-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF8F6"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.campusbite.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "CampusBite needs your location to set your delivery address."
      }
    },
    "android": {
      "package": "com.campusbite.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFF8F6"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCXNqzPOiqs3MhkNXV3Ao5KlNWXqirlBLs"
        }
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CampusBite needs your location to set your delivery address."
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "59ce99ff-2db9-4794-b9c1-2d4024f4fb65"
      }
    },
    "owner": "alphaninyo_06"
  }
}
